<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>metamcp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MetaMCP</AssemblyName>
    <RootNamespace>MetaMCP.Host</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="metamcp.ico" CopyToOutputDirectory="Never" />
    <EmbeddedResource Include="metamcp_32.png" LogicalName="metamcp_32.png" />
    <EmbeddedResource Include="icons\json-light.png" LogicalName="json-light.png" />
    <EmbeddedResource Include="icons\json-dark.png" LogicalName="json-dark.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MetaMCP.Host.Core\MetaMCP.Host.Core.csproj" />
  </ItemGroup>
</Project>