{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: MetaMCP Windows bootstrapper",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Run-WindowsBootstrapper.ps1\"",
      "group": "launch",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Запускає стабільний root MetaMCP.exe; ReleaseA/B залишаються runtime payload",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Package: Select target",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Package-SelectedTarget.ps1\" -Target ${input:packageTarget}",
      "group": "build",
      "problemMatcher": [],
      "detail": "win-x64 → inactive A/B slot; Linux → Release platform directory"
    },
    {
      "label": "Package: Windows x64",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Build-WindowsCandidate.ps1\"",
      "group": "build",
      "problemMatcher": [],
      "detail": "Збирає лише неактивний Windows A/B slot; live MetaMCP не перезапускається"
    },
    {
      "label": "Deploy: Windows runtime hot-swap",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Update-WindowsAB.ps1\"",
      "group": "build",
      "problemMatcher": [],
      "detail": "Build inactive runtime → live gateway swap → session-aware drain старого slot без restart bootstrapper"
    },
    {
      "label": "Runtime: Windows status",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Swap-WindowsRuntime.ps1\" -Status",
      "problemMatcher": [],
      "detail": "Показує stable bootstrapper, active/draining runtime slots і session counts"
    },
    {
      "label": "Install/Update: Windows bootstrapper",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Install-WindowsBootstrapper.ps1\"",
      "group": "build",
      "problemMatcher": [],
      "detail": "Оновлює сам root MetaMCP.exe; на відміну від runtime swap коротко перезапускає gateway"
    },
    {
      "label": "Package: Linux x64",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Package-SelectedTarget.ps1\" -Target linux-x64",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package: Linux ARM64",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Package-SelectedTarget.ps1\" -Target linux-arm64",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package: All platforms",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\Package-SelectedTarget.ps1\" -Target all",
      "group": "build",
      "problemMatcher": [],
      "detail": "Windows → inactive A/B slot; потім Linux x64 та ARM64 platform packages",
      "hide": true,
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "Build: MetaMCP.Host.Linux (Release)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Linux -c Release",
      "group": "build",
      "problemMatcher": "$msCompile",
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "Build: MetaMCP.Host.Windows (Release)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Windows -c Release",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Host.Windows у Release"
    },
    {
      "label": "Build: MetaMCP.Host.Windows (Debug)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Windows -c Debug",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Host.Windows у Debug"
    },
    {
      "label": "Build: MetaMCP.Packager (Release)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Packager -c Release",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Packager у Release"
    },
    {
      "label": "Build: MetaMCP.Packager (Debug)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Packager -c Debug",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Packager у Debug"
    },
    {
      "label": "Run: MetaMCP.Host.Windows (Debug)",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Host.Windows",
      "group": "launch",
      "problemMatcher": [],
      "detail": "Запускає MetaMCP.Host.Windows у tray-режимі (Debug)",
      "dependsOn": "Build: MetaMCP.Host.Windows (Debug)"
    },
    {
      "label": "Run: MetaMCP.Packager (Debug)",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager",
      "group": "launch",
      "problemMatcher": [],
      "detail": "Запускає MetaMCP.Packager (Debug)",
      "prompt": {
        "type": "promptString",
        "name": "repoPath",
        "message": "Шлях до джерельного монорепо metamcp (або натисни Enter для default):",
        "default": "C:\\DEV\\LLM\\metamcp"
      },
      "args": [
        "--repo",
        "${input:repoPath}"
      ]
    },
    {
      "label": "Dev: Backend (tsx watch)",
      "type": "shell",
      "command": "cd C:\\DEV\\LLM\\metamcp && pnpm --filter backend dev",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Запускає backend із source monorepo у dev/watch режимі",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Dev: Frontend (next dev)",
      "type": "shell",
      "command": "cd C:\\DEV\\LLM\\metamcp && pnpm --filter frontend dev",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Запускає frontend із source monorepo у Next.js dev режимі",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build: Frontend (next build)",
      "type": "shell",
      "command": "cd C:\\DEV\\LLM\\metamcp && pnpm --filter frontend build",
      "group": "build",
      "problemMatcher": [],
      "detail": "Збирає frontend із source monorepo"
    },
    {
      "label": "Build: Backend (tsup)",
      "type": "shell",
      "command": "cd C:\\DEV\\LLM\\metamcp && pnpm --filter backend build",
      "group": "build",
      "problemMatcher": [],
      "detail": "Збирає backend із source monorepo"
    }
  ],
  "inputs": [
    {
      "id": "repoPath",
      "type": "promptString",
      "description": "Шлях до джерельного монорепо metamcp",
      "default": "C:\\DEV\\LLM\\metamcp"
    },
    {
      "id": "packageTarget",
      "type": "pickString",
      "description": "Платформа пакета",
      "options": [
        "win-x64",
        "linux-x64",
        "linux-arm64",
        "all"
      ],
      "default": "win-x64"
    }
  ]
}
