{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: MetaMCP.Host.Windows (Release portable)",
      "type": "shell",
      "command": "Release\\MetaMCP.exe",
      "group": "launch",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Запускає готовий MetaMCP.exe з Release-папки",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Package: Select target",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager -c Release -- --repo C:\\DEV\\LLM\\metamcp --target ${input:packageTarget} --output Artifacts\\${input:packageTarget}",
      "group": "build",
      "problemMatcher": [],
      "detail": "Збирає вибраний платформний пакет"
    },
    {
      "label": "Package: Windows x64",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager -c Release -- --repo C:\\DEV\\LLM\\metamcp --target win-x64 --output Release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package: Linux x64",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager -c Release -- --repo C:\\DEV\\LLM\\metamcp --target linux-x64 --output Artifacts\\linux-x64",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package: Linux ARM64",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager -c Release -- --repo C:\\DEV\\LLM\\metamcp --target linux-arm64 --output Artifacts\\linux-arm64",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package: All platforms",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager -c Release -- --repo C:\\DEV\\LLM\\metamcp --target all --output Release-Multi",
      "group": "build",
      "problemMatcher": [],
      "detail": "Один production build, потім win-x64, linux-x64 та linux-arm64"
    },
    {
      "label": "Build: MetaMCP.Host.Linux (Release)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Linux -c Release",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Dev: Quick (Host)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Windows -c Debug -q && dotnet run --project src\\MetaMCP.Host.Windows -c Debug -- --base Release",
      "group": "launch",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Швидкий запуск: збирає Host (Debug) та запускає з Release. Без пакувальника.",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Dev: Rebuild + Run (Host + Packager)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Windows -c Debug -q && dotnet run --project src\\MetaMCP.Packager -c Release -- --repo C:\\DEV\\LLM\\metamcp && dotnet run --project src\\MetaMCP.Host.Windows -c Debug -- --base Release",
      "group": "launch",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Повне перепакування + запуск Host (Debug). Повільно.",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build: MetaMCP.Host.Windows (Release)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Windows -c Release",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Host.Windows у Release"
    },
    {
      "label": "Build: MetaMCP.Host.Windows (Debug)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Host.Windows -c Debug",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Host.Windows у Debug"
    },
    {
      "label": "Build: MetaMCP.Packager (Release)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Packager -c Release",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Packager у Release"
    },
    {
      "label": "Build: MetaMCP.Packager (Debug)",
      "type": "shell",
      "command": "dotnet build src\\MetaMCP.Packager -c Debug",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Збирає MetaMCP.Packager у Debug"
    },
    {
      "label": "Run: MetaMCP.Host.Windows (Debug)",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Host.Windows",
      "group": "launch",
      "problemMatcher": [],
      "detail": "Запускає MetaMCP.Host.Windows у tray-режимі (Debug)",
      "dependsOn": "Build: MetaMCP.Host.Windows (Debug)"
    },
    {
      "label": "Run: MetaMCP.Packager (Debug)",
      "type": "shell",
      "command": "dotnet run --project src\\MetaMCP.Packager",
      "group": "launch",
      "problemMatcher": [],
      "detail": "Запускає MetaMCP.Packager (Debug)",
      "prompt": {
        "type": "promptString",
        "name": "repoPath",
        "message": "Шлях до джерельного монорепо metamcp (або натисни Enter для default):",
        "default": "C:\\DEV\\LLM\\metamcp"
      },
      "args": [
        "--repo",
        "${input:repoPath}"
      ]
    },
    {
      "label": "Dev: Backend (tsx watch)",
      "type": "shell",
      "command": "cd Release\\metamcp\\backend && pnpm dev",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Запускає backend у dev-режимі з гарячим перезавантаженням",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Dev: Frontend (next dev)",
      "type": "shell",
      "command": "cd Release\\metamcp\\frontend && pnpm dev",
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Запускає frontend (Next.js) у dev-режимі на порту 12008",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build: Frontend (next build)",
      "type": "shell",
      "command": "cd Release\\metamcp\\frontend && pnpm build",
      "group": "build",
      "problemMatcher": [],
      "detail": "Збирає Next.js frontend"
    },
    {
      "label": "Build: Backend (tsup)",
      "type": "shell",
      "command": "cd Release\\metamcp\\backend && pnpm build",
      "group": "build",
      "problemMatcher": [],
      "detail": "Збирає backend через tsup"
    }
  ],
  "inputs": [
    {
      "id": "repoPath",
      "type": "promptString",
      "description": "Шлях до джерельного монорепо metamcp",
      "default": "C:\\DEV\\LLM\\metamcp"
    },
    {
      "id": "packageTarget",
      "type": "pickString",
      "description": "Платформа пакета",
      "options": [
        "win-x64",
        "linux-x64",
        "linux-arm64",
        "all"
      ],
      "default": "win-x64"
    }
  ]
}
